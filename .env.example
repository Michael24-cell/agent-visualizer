# Copy to .env.local (git-ignored). Values here are read by `npm run dev`
# and `npm start`; anything already exported in your shell wins.

# Which runtime answers agent tasks: auto | simulated | claude | local
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise simulated.
HARNESS_RUNTIME=simulated

# Claude via the Agent SDK (pay per token).
# ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint when HARNESS_RUNTIME=local.
# Groq free tier:
# HARNESS_LOCAL_BASE_URL=https://api.groq.com/openai/v1
# HARNESS_LOCAL_MODEL=openai/gpt-oss-120b   (GET /api/runtime/models lists what your key can use)
# HARNESS_LOCAL_API_KEY=
# HARNESS_LOCAL_TOOLS=full
# Ollama on this machine (default when unset):
# HARNESS_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# HARNESS_LOCAL_MODEL=qwen2.5-coder:7b
# HARNESS_LOCAL_TOOLS=basic
