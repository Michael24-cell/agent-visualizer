{
  "name": "@harness/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '../../node_modules/**' src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --sourcemap --external:better-sqlite3 --external:fastify --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@harness/config": "*",
    "@harness/contracts": "*",
    "@harness/domain": "*",
    "@harness/persistence": "*",
    "@harness/runtime-simulated": "*",
    "fastify": "^5.0.0"
  }
}
